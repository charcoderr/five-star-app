{
  "expo": {
    "name": "5StarX",
    "slug": "5starx",
    "owner": "fuseva",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "fivestar",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2C2C2E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.5starx.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take photos as evidence for your mystery dine report.",
        "NSPhotoLibraryUsageDescription": "Used to attach photos to your mystery dine report.",
        "NSUserNotificationsUsageDescription": "We'll send you booking reminders and updates about your mystery dine assignments.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fivestarx.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2C2C2E"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/11633646-6ade-4adf-b050-8b02aa2ea0a4"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C9A84C",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to attach photos to your mystery dine report.",
          "cameraPermission": "Used to take photos as evidence for your mystery dine report."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "11633646-6ade-4adf-b050-8b02aa2ea0a4"
      }
    }
  }
}
