# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ── Supabase ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Stripe ────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
# Secret key stays server-side (Supabase Edge Function env var) — never here

# ── App environment ───────────────────────────────────────────────────────────
# Set automatically by EAS build profiles: development | preview | production
APP_ENV=development
